  },
  "carsi": {
    "enabled": true,
    "portal": "http://carsi.whut.edu.cn/",
    "idp_entity_id": "https://idp.whut.edu.cn/idp/shibboleth"
  },
  "auth": {
    "mode": "manual",
    "login_url": "https://zhlgd.whut.edu.cn/tpass/login?service=https%3A%2F%2Fwebvpn.whut.edu.cn%2Flogin%3Fcas_login%3Dtrue",
    "manual_open_url": "https://webvpn.whut.edu.cn/login?cas_login=true",
    "username_field": "un",
    "password_field": "pd",
    "extra_fields": {},
    "hidden_fields": ["lt", "execution", "_eventId"],
    "success_url_contains": [],
